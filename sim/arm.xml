<mujoco model="james_arm">
  <!-- Built from the printed parts in meshes/ (mm, exported lying flat: thickness along y).
       Pivots are assumed 15 mm from each link end and 35 mm above the turntable: measure and adjust. -->
  <compiler meshdir="meshes" angle="degree"/>
  <option gravity="0 0 -9.81"/>
  <visual><global offwidth="1280" offheight="720"/></visual>
  <asset>
    <mesh name="base" file="base.stl" scale="0.001 0.001 0.001"/>
    <mesh name="lid" file="lid.stl" scale="0.001 0.001 0.001"/>
    <mesh name="link1" file="link1.stl" scale="0.001 0.001 0.001"/>
    <mesh name="link2" file="link2.stl" scale="0.001 0.001 0.001"/>
    <mesh name="link3" file="link3.stl" scale="0.001 0.001 0.001"/>
    <mesh name="link4" file="link4.stl" scale="0.001 0.001 0.001"/>
  </asset>
  <default>
    <geom type="mesh" contype="0" conaffinity="0"/>
    <joint type="hinge" damping="1"/>
  </default>
  <worldbody>
    <light pos="0.5 -0.5 1.5" dir="-0.3 0.3 -1"/>
    <geom name="floor" type="plane" size="1 1 0.1" rgba="0.85 0.85 0.85 1" contype="1" conaffinity="1"/>
    <!-- flat parts: file y (thickness) -> world z; quat = +90deg about x -->
    <geom mesh="base" quat="0.7071 0.7071 0 0" pos="-0.100 0.150 -0.020" rgba="0.3 0.3 0.35 1"/>
    <geom mesh="lid" quat="0.7071 0.7071 0 0" pos="-0.060 0.060 0.052" rgba="0.35 0.35 0.4 1"/>
    <body name="turret" pos="0 0 0.062">
      <joint name="base" axis="0 0 1" range="-135 135"/>
      <geom name="base" mesh="link1" quat="0.7071 0.7071 0 0" pos="-0.060 0.060 0" rgba="0.2 0.4 0.8 1"/>
      <geom type="box" size="0.02 0.01 0.0175" pos="0 0.03 0.0275" rgba="0.15 0.15 0.15 1"/>  <!-- shoulder servo -->
      <body name="upper" pos="0 0 0.045">
        <joint name="shoulder" axis="0 1 0" range="-70 70"/>
        <!-- arm links: file z (length) -> world z; quat = +90deg about z, pivot 15 mm from the end -->
        <geom name="shoulder" mesh="link2" quat="0.7071 0 0 0.7071" pos="0.015 -0.0325 -0.015" rgba="0.9 0.5 0.1 1"/>
        <body name="fore" pos="0 0 0.170">
          <joint name="elbow" axis="0 1 0" range="-70 70"/>
          <geom name="elbow" mesh="link3" quat="0.7071 0 0 0.7071" pos="-0.014 -0.0275 -0.015" rgba="0.2 0.7 0.4 1"/>
          <body name="hand" pos="0 0 0.170">
            <joint name="wrist" axis="0 1 0" range="-90 90"/>
            <geom name="wrist" mesh="link4" quat="0.7071 0 0 0.7071" pos="0.010 -0.050 -0.015" rgba="0.6 0.6 0.6 1"/>
            <body name="finger_l" pos="0 0.02 0.135">
              <joint name="claw" type="slide" axis="0 1 0" range="-0.02 0.0"/>
              <geom type="box" size="0.008 0.004 0.03" pos="0 0.004 0.03" rgba="0.8 0.1 0.1 1"/>
            </body>
            <body name="finger_r" pos="0 -0.02 0.135">
              <joint name="claw_r" type="slide" axis="0 1 0" range="0.0 0.02"/>
              <geom type="box" size="0.008 0.004 0.03" pos="0 -0.004 0.03" rgba="0.8 0.1 0.1 1"/>
            </body>
          </body>
        </body>
      </body>
    </body>
  </worldbody>
</mujoco>
